# ==========================================================================
# Jubileo Financiero — Reglas del servidor (Hostinger / Apache)
# ==========================================================================

# Dominio canónico: sin www y siempre por HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Si el host empieza con www, redirige 301 a la versión sin www (por HTTPS).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Si la conexión no es HTTPS, fuerza HTTPS con 301.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
